{
  "name": "goat-store",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:seed:technology": "node --env-file=.env --import tsx prisma/seed-technology.ts",
    "db:seed:secondhand": "node --env-file=.env --import tsx prisma/seed-secondhand.ts",
    "test:inventory": "node --import tsx tests/inventory.integration.mjs",
    "email:check": "node --env-file=.env --import tsx scripts/check-email.ts",
    "test:streaming": "node --import tsx tests/streaming-inventory.integration.mjs",
    "db:migrate:check": "node --env-file=.env --env-file=.env.migration --import tsx scripts/migrate-database.ts",
    "db:migrate:apply": "node --env-file=.env --env-file=.env.migration --import tsx scripts/migrate-database.ts --apply",
    "test:migration": "node --import tsx tests/database-migration.integration.mjs",
    "test:duplicate": "node --import tsx tests/product-duplicate.integration.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.0"
  }
}

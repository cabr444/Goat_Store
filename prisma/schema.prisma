generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  VENDEDOR
  ADMIN
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  sessionVersion Int           @default(0)
  passwordResets PasswordReset[]
  passwordHash String
  role         Role          @default(CLIENTE)
  balance      Int           @default(0)
  createdAt    DateTime      @default(now())
  products     Product[]
  orders       Order[]
  walletEvents WalletEvent[]
}

model Product {
  stock Int @default(0)
  deliveryCipher String?
  id          String      @id @default(cuid())
  name        String
  category    String
  price       Int
  description String      @default("")
  mark        String      @default("✦")
  gradient    String      @default("linear-gradient(135deg,#7446ed,#ff79bf)")
  active      Boolean     @default(true)
  ownerId     String?
  owner       User?       @relation(fields: [ownerId], references: [id])
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

model OrderCounter {
  id String @id
  value Int @default(0)
}

model Order {
  checkoutAttempt CheckoutAttempt?
  reference String? @unique
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  total     Int
  status    String      @default("PENDIENTE_ENTREGA")
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  receiptCipher String?
  category String @default("")
  sellerId String?
  @@index([sellerId])
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  unitPrice Int
  quantity  Int
}

model WalletEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  type      String
  note      String
  createdAt DateTime @default(now())
}

model PasswordReset {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model BannerImage {
  slot Int @id
  data Bytes
  contentType String
  updatedAt DateTime @updatedAt
}

model RateLimit {
  key String @id
  count Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}

model CatalogImageAsset {
  key String @id
  data Bytes
  contentType String
  updatedAt DateTime @updatedAt
}

model StoreSettings {
  id String @id @default("main")
  tiendaEnabled Boolean @default(true)
  segundaEnabled Boolean @default(true)
}

model CatalogOrder {
  kind String @id
  ids Json
  version Int @default(0)
}

model PendingRegistration {
  email String @id
  name String
  passwordHash String
  role Role
  tokenHash String @unique
  statusHash String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  confirmedAt DateTime?
  @@index([expiresAt])
}

model CheckoutAttempt {
  key String @id
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

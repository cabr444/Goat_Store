# PostgreSQL used by the application. Replace all placeholders.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/goat?schema=public"

# Required: generate a random secret of at least 32 characters.
# Example command: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Optional separate encryption secret. Keep it stable after saving private accesses.
# When empty, encryption uses AUTH_SECRET.
DELIVERY_SECRET=""

# Exact application origin. Use your public HTTPS URL when deploying.
APP_URL="http://localhost:3000"

# Required for password reset and expiry reminder emails. Registration does not send email.
RESEND_API_KEY=""
# Local testing only: Goat <onboarding@resend.dev> can send only to your Resend account email.
# To register other recipients, verify your own sending domain in Resend.
EMAIL_FROM="Goat <acceso@tu-dominio.com>"

# Required only when seeding the initial administrator.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Expiry reminders (daily Vercel cron). Generate a separate random 32+ character secret.
CRON_SECRET=""
# Optional: one destination address; otherwise all administrator account emails receive notices.
EXPIRY_NOTIFICATION_EMAIL=""

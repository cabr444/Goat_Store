# PostgreSQL used by the application. Replace all placeholders.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/goat?schema=public"

# Required: generate a random secret of at least 32 characters.
# Example command: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Optional separate encryption secret. Keep it stable after saving private accesses.
# When empty, encryption uses AUTH_SECRET.
DELIVERY_SECRET=""

# Exact application origin. Use your public HTTPS URL when deploying.
APP_URL="http://localhost:3000"

# Required for registration confirmation and password reset emails.
RESEND_API_KEY=""
EMAIL_FROM="Goat <acceso@tu-dominio.com>"

# Required only when seeding the initial administrator.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

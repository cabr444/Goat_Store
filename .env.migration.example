# Copy this file to .env.migration locally; never commit actual connection strings.
# Use direct connections, or a session pooler if Supabase direct IPv6 is unavailable.
# SOURCE is the original Supabase PostgreSQL database; TARGET is the empty Neon database.
SOURCE_DATABASE_URL=""
TARGET_DATABASE_URL=""
# Keep DATABASE_URL in .env pointing to Neon and keep the original encryption secrets there.
